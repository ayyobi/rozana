---
import AppLayout from '@/layouts/AppLayout.astro';
import PlanningApp from '@/components/calendar/PlanningApp';
import { useTranslations } from '@/i18n';
import { isDayStr, todayIn } from '@/lib/utils/day';

const locale = Astro.locals.locale;
const t = useTranslations(locale);
const today = todayIn(Astro.locals.timezone);
const param = Astro.url.searchParams.get('date');
const date = isDayStr(param) ? param : today;
const currency = Astro.locals.settings?.currency ?? 'EUR';
---

<AppLayout title={t('nav.planning')}>
  <PlanningApp client:load locale={locale} today={today} view="day" date={date} currency={currency} />
</AppLayout>
