---
import BaseLayout from '@/layouts/BaseLayout.astro';
// Vue par défaut adaptée à l'écran : jour sur téléphone, semaine sur ordinateur.
const date = Astro.url.searchParams.get('date');
const q = date && /^\d{4}-\d{2}-\d{2}$/.test(date) ? `?date=${date}` : '';
---

<BaseLayout title="Planning">
  <script is:inline define:vars={{ q }}>
    location.replace((window.innerWidth < 768 ? '/planning/jour' : '/planning/semaine') + q);
  </script>
  <noscript><meta http-equiv="refresh" content={`0;url=/planning/semaine${q}`} /></noscript>
</BaseLayout>
