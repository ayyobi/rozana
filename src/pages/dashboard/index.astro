---
import AppLayout from '@/layouts/AppLayout.astro';
import DashboardHeader from '@/components/dashboard/DashboardHeader.astro';
import Dashboard from '@/components/dashboard/Dashboard';
import { useTranslations } from '@/i18n';
import { nowIn } from '@/lib/utils/dates';
import { todayIn } from '@/lib/utils/day';

const locale = Astro.locals.locale;
const t = useTranslations(locale);
const timeZone = Astro.locals.timezone;
const now = nowIn(timeZone);
const today = todayIn(timeZone);
const currency = Astro.locals.settings?.currency ?? 'EUR';
---

<AppLayout title={t('nav.dashboard')}>
  <DashboardHeader now={now} timeZone={timeZone} />
  <Dashboard client:load locale={locale} todayIso={today} timeZone={timeZone} currency={currency} />
</AppLayout>
