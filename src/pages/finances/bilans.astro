---
import AppLayout from '@/layouts/AppLayout.astro';
import FinanceTabs from '@/components/finance/FinanceTabs.astro';
import ReportsApp from '@/components/finance/ReportsApp';
import { useTranslations } from '@/i18n';
import { todayIn } from '@/lib/utils/day';

const locale = Astro.locals.locale;
const t = useTranslations(locale);
const today = todayIn(Astro.locals.timezone);
const currency = Astro.locals.settings?.currency ?? 'EUR';
const alertPct = Astro.locals.settings?.budget_alert_pct || 80;
---

<AppLayout title={t('finance.reports.title')}>
  <h1 class="mb-4 text-3xl font-semibold sm:text-4xl">{t('finance.reports.title')}</h1>
  <FinanceTabs />
  <ReportsApp client:load locale={locale} today={today} currency={currency} alertPct={alertPct} />
</AppLayout>
