---
import AppLayout from '@/layouts/AppLayout.astro';
import StatsApp from '@/components/stats/StatsApp';
import { useTranslations } from '@/i18n';
import { todayIn } from '@/lib/utils/day';
const locale = Astro.locals.locale;
const t = useTranslations(locale);
---

<AppLayout title={t('nav.stats')}>
  <StatsApp client:load locale={locale} today={todayIn(Astro.locals.timezone)} currency={Astro.locals.settings?.currency ?? 'EUR'} />
</AppLayout>
