---
import AppLayout from '@/layouts/AppLayout.astro';
import { useTranslations, LOCALES } from '@/i18n';
import { buttonClasses } from '@/components/ui/Button';
import { DEFAULT_TIMEZONE } from '@/lib/utils/dates';
import { Languages, Globe2, CheckCircle2 } from 'lucide-react';

const locale = Astro.locals.locale;
const t = useTranslations(locale);
const saved = Astro.url.searchParams.get('saved') === 'locale';
---

<AppLayout title={t('settings.title')}>
  <h1 class="mb-6 text-3xl font-semibold sm:text-4xl">{t('settings.title')}</h1>

  {
    saved && (
      <p role="status" class="mb-5 flex items-start gap-2 rounded-2xl bg-[#eef4ea] px-4 py-3 text-sm font-medium text-ink">
        <CheckCircle2 className="mt-0.5 size-4 shrink-0 text-sage-strong" aria-hidden="true" />
        {t('settings.savedLocally')}
      </p>
    )
  }

  <div class="grid gap-5 lg:grid-cols-2">
    <section class="card p-6" aria-labelledby="lang-title">
      <h2 id="lang-title" class="flex items-center gap-2 text-xl font-semibold">
        <Languages className="size-5" aria-hidden="true" />{t('settings.language')}
      </h2>
      <p class="mt-1 mb-4 text-sm text-ink-2">{t('settings.languageHint')}</p>
      <form method="post" action="/api/preferences/locale" class="flex flex-col gap-3">
        <fieldset class="flex flex-col gap-2">
          <legend class="sr-only">{t('settings.language')}</legend>
          {
            LOCALES.map((l) => (
              <label class="flex cursor-pointer items-center gap-3 rounded-2xl border-2 border-transparent bg-bg/40 px-4 py-3 has-[:checked]:border-coral-strong has-[:checked]:bg-white/70">
                <input type="radio" name="locale" value={l} checked={l === locale} class="size-4 accent-[var(--color-coral-strong)]" />
                <span class="font-medium" lang={l} dir={l === 'fa' ? 'rtl' : 'ltr'} style={l === 'fa' ? 'font-family: var(--font-fa)' : ''}>
                  {t(`settings.${l}`)}
                </span>
              </label>
            ))
          }
        </fieldset>
        <button type="submit" class={buttonClasses('primary', 'md', 'self-start')}>{t('common.save')}</button>
      </form>
    </section>

    <section class="card p-6" aria-labelledby="tz-title">
      <h2 id="tz-title" class="flex items-center gap-2 text-xl font-semibold">
        <Globe2 className="size-5" aria-hidden="true" />{t('settings.timezone')}
      </h2>
      <p class="mt-1 mb-4 text-sm text-ink-2">{t('settings.timezoneHint')}</p>
      <p class="rounded-2xl bg-bg/40 px-4 py-3 font-medium" dir="ltr">{DEFAULT_TIMEZONE}</p>
      <p class="mt-3 text-sm text-ink-2">{t('common.comingSoonText', { phase: 2 })}</p>
    </section>
  </div>
</AppLayout>
