---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Logo from '@/components/layout/Logo.astro';
import SignupForm from '@/components/auth/SignupForm';
import { Sunrise } from '@/components/ui/illustrations';
import { useTranslations } from '@/i18n';
import { getSetupStatus } from '@/lib/pocketbase/server';
import { Lock } from 'lucide-react';

if (Astro.locals.user) return Astro.redirect('/dashboard');

const locale = Astro.locals.locale;
const t = useTranslations(locale);
const status = await getSetupStatus(Astro.locals.pb);
// Un compte existe déjà : l'inscription n'a plus lieu d'être.
if (status.reachable && !status.signupOpen) return Astro.redirect('/connexion?closed=1');
---

<BaseLayout title={t('auth.signupTitle')}>
  <main class="grid min-h-dvh place-items-center px-5 py-[max(env(safe-area-inset-top),32px)]">
    <div class="w-full max-w-md animate-fade-up">
      <div class="mb-8 flex flex-col items-center gap-3 text-center">
        <Logo size="lg" />
        <p class="font-display text-lg text-ink">{t('app.tagline')}</p>
      </div>

      <section class="card relative overflow-clip p-7 sm:p-9" aria-labelledby="signup-title">
        <div class="pointer-events-none absolute -end-8 -top-6 w-32 text-coral-strong/25" aria-hidden="true"><Sunrise /></div>
        <h1 id="signup-title" class="text-2xl font-semibold">{t('auth.signupTitle')}</h1>
        <p class="mt-1 mb-6 text-ink-2">{t('auth.signupSubtitle')}</p>
        {!status.reachable && <p role="alert" class="mb-4 rounded-2xl bg-danger/10 px-4 py-3 text-sm font-medium text-danger">{t('auth.pbDown')}</p>}
        <SignupForm client:load locale={locale} inviteRequired={status.reachable && status.inviteRequired} />
        <p class="mt-5 text-center text-sm">
          <a href="/connexion" class="font-medium text-coral-strong underline-offset-4 hover:underline">{t('auth.haveAccount')}</a>
        </p>
      </section>

      <p class="mt-6 flex items-center justify-center gap-1.5 text-sm text-ink">
        <Lock className="size-3.5" aria-hidden="true" />
        {t('auth.private')}
      </p>
    </div>
  </main>
</BaseLayout>
