---
import AppLayout from '@/layouts/AppLayout.astro';
import ProjectDetail from '@/components/projects/ProjectDetail';
import { useTranslations } from '@/i18n';
import { todayIn } from '@/lib/utils/day';
const locale = Astro.locals.locale;
const t = useTranslations(locale);
const id = Astro.params.id ?? '';
if (!/^[a-z0-9]{15}$/.test(id)) return Astro.redirect('/projets');
---

<AppLayout title={t('nav.projects')}>
  <ProjectDetail client:load locale={locale} today={todayIn(Astro.locals.timezone)} projectId={id} />
</AppLayout>
