---
import Logo from './Logo.astro';
import { NAV_ITEMS, isActive } from '@/lib/navigation';
import { useTranslations } from '@/i18n';
import { LogOut } from 'lucide-react';

const t = useTranslations(Astro.locals.locale);
const path = Astro.url.pathname;
---

<aside class="sticky top-0 hidden h-dvh w-64 shrink-0 flex-col gap-8 px-5 py-7 lg:flex" aria-label={t('nav.main')}>
  <div class="px-2"><Logo /></div>

  <nav class="flex flex-1 flex-col gap-1" aria-label={t('nav.main')}>
    {
      NAV_ITEMS.map((item) => {
        const active = isActive(path, item.href);
        const Icon = item.icon;
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'flex h-11 items-center gap-3 rounded-2xl px-3.5 text-[0.95rem] font-medium transition-colors duration-200',
              active ? 'bg-surface text-ink shadow-soft' : 'text-ink hover:bg-surface/55',
            ]}
          >
            <span class:list={['grid size-8 place-items-center rounded-xl transition-colors', active ? 'bg-coral' : 'bg-transparent']}>
              <Icon className="size-[18px]" strokeWidth={1.9} aria-hidden="true" />
            </span>
            {t(item.label)}
          </a>
        );
      })
    }
  </nav>

  <div class="rounded-card bg-surface/70 p-4">
    <p class="font-display text-sm text-ink">{t('app.tagline')}</p>
    <form method="post" action="/api/auth/logout" class="mt-3">
      <button type="submit" class="inline-flex h-10 items-center gap-2 rounded-pill px-3 text-sm font-medium text-ink hover:bg-ink/5">
        <LogOut className="size-4 rtl:-scale-x-100" aria-hidden="true" />
        {t('nav.logout')}
      </button>
    </form>
  </div>
</aside>
