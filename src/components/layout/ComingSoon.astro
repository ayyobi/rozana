---
import AppLayout from '@/layouts/AppLayout.astro';
import { useTranslations } from '@/i18n';
import { buttonClasses } from '@/components/ui/Button';
import { Sunrise } from '@/components/ui/illustrations';

interface Props {
  title: string;
  phase: number;
  /** Sous-navigation éventuelle (ex. vues du planning, sections finances). */
  tabs?: Array<{ href: string; label: string }>;
}
const { title, phase, tabs } = Astro.props;
const t = useTranslations(Astro.locals.locale);
const path = Astro.url.pathname;
---

<AppLayout title={title}>
  <h1 class="mb-5 text-3xl font-semibold sm:text-4xl">{title}</h1>
  {
    tabs && (
      <nav class="-mx-4 mb-5 overflow-x-auto px-4" aria-label={title}>
        <ul class="flex w-max gap-2">
          {tabs.map((tab) => (
            <li>
              <a
                href={tab.href}
                aria-current={path === tab.href ? 'page' : undefined}
                class:list={[
                  'inline-flex h-10 items-center rounded-pill px-4 text-sm font-medium whitespace-nowrap transition-colors',
                  path === tab.href ? 'bg-coral' : 'bg-surface/70 hover:bg-surface',
                ]}
              >
                {tab.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  <section class="card flex flex-col items-center gap-3 px-6 py-14 text-center">
    <div class="w-28 text-coral-strong/80" aria-hidden="true"><Sunrise /></div>
    <h2 class="text-xl font-semibold">{t('common.comingSoon')}</h2>
    <p class="max-w-md text-ink-2">{t('common.comingSoonText', { phase })}</p>
    <a href="/dashboard" class={buttonClasses('secondary', 'md', 'mt-2')}>{t('common.backToDashboard')}</a>
  </section>
</AppLayout>
