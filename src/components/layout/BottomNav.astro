---
import { NAV_ITEMS, isActive } from '@/lib/navigation';
import { useTranslations } from '@/i18n';
import { Ellipsis, LogOut } from 'lucide-react';

const t = useTranslations(Astro.locals.locale);
const path = Astro.url.pathname;
const primary = NAV_ITEMS.filter((i) => i.mobile);
const secondary = NAV_ITEMS.filter((i) => !i.mobile);
const moreActive = secondary.some((i) => isActive(path, i.href));
---

<nav
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line/60 bg-surface/92 backdrop-blur-md pb-safe lg:hidden"
  aria-label={t('nav.main')}
>
  <ul class="mx-auto grid h-16 max-w-xl grid-cols-5">
    {
      primary.map((item) => {
        const active = isActive(path, item.href);
        const Icon = item.icon;
        return (
          <li>
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class="flex h-full flex-col items-center justify-center gap-0.5 text-[0.7rem] font-medium text-ink"
            >
              <span class:list={['grid h-7 w-12 place-items-center rounded-pill transition-colors duration-200', active ? 'bg-coral' : '']}>
                <Icon className="size-5" strokeWidth={active ? 2.2 : 1.8} aria-hidden="true" />
              </span>
              {t(item.label)}
            </a>
          </li>
        );
      })
    }
    <li>
      <button
        type="button"
        popovertarget="more-menu"
        class="flex h-full w-full flex-col items-center justify-center gap-0.5 text-[0.7rem] font-medium text-ink"
      >
        <span class:list={['grid h-7 w-12 place-items-center rounded-pill', moreActive ? 'bg-coral' : '']}>
          <Ellipsis className="size-5" aria-hidden="true" />
        </span>
        {t('nav.more')}
      </button>
    </li>
  </ul>
</nav>

<!-- Feuille « Plus » (API Popover native : fonctionne sans JavaScript) -->
<div
  id="more-menu"
  popover
  class="sheet m-0 mt-auto w-full max-w-none rounded-t-[28px] border-0 bg-surface p-5 text-ink shadow-lift lg:hidden"
  style="padding-bottom: max(env(safe-area-inset-bottom), 20px)"
>
  <div class="mx-auto mb-4 h-1.5 w-10 rounded-pill bg-ink/15" aria-hidden="true"></div>
  <ul class="grid grid-cols-3 gap-3">
    {
      secondary.map((item) => {
        const Icon = item.icon;
        const active = isActive(path, item.href);
        return (
          <li>
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'flex aspect-square flex-col items-center justify-center gap-2 rounded-2xl text-sm font-medium',
                active ? 'bg-coral' : 'bg-bg/50 hover:bg-bg/80',
              ]}
            >
              <Icon className="size-6" strokeWidth={1.8} aria-hidden="true" />
              {t(item.label)}
            </a>
          </li>
        );
      })
    }
    <li>
      <form method="post" action="/api/auth/logout" class="h-full">
        <button type="submit" class="flex aspect-square w-full flex-col items-center justify-center gap-2 rounded-2xl bg-bg/50 text-sm font-medium hover:bg-bg/80">
          <LogOut className="size-6 rtl:-scale-x-100" strokeWidth={1.8} aria-hidden="true" />
          {t('nav.logout')}
        </button>
      </form>
    </li>
  </ul>
</div>

<style>
  .sheet {
    inset: auto 0 0 0;
    transition:
      transform 240ms var(--ease-soft),
      opacity 200ms,
      overlay 240ms allow-discrete,
      display 240ms allow-discrete;
    transform: translateY(100%);
  }
  .sheet:popover-open {
    transform: none;
  }
  @starting-style {
    .sheet:popover-open {
      transform: translateY(100%);
    }
  }
  .sheet::backdrop {
    background: rgb(47 41 37 / 0.3);
  }
</style>
