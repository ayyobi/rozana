---
import '@/styles/global.css';
import { dirOf, useTranslations } from '@/i18n';

interface Props {
  title?: string;
}
const { title } = Astro.props;
const locale = Astro.locals.locale;
const t = useTranslations(locale);
const fullTitle = title ? `${title} · Rozana` : `Rozana — ${t('app.tagline')}`;
---

<!doctype html>
<html lang={locale} dir={dirOf(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={t('app.tagline')} />
    <meta name="theme-color" content="#EEE7DD" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="noindex, nofollow" />
    <!-- iOS : application installée sur l'écran d'accueil -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Rozana" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <title>{fullTitle}</title>
  </head>
  <body class="text-ink antialiased">
    <slot />
  </body>
</html>
