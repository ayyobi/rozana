# ───────────────────────────────────────────────
# Rozana — variables d'environnement (exemple, sans secrets)
# Copie ce fichier en `.env` et remplis les valeurs localement.
# Ne colle JAMAIS ces valeurs dans une conversation ni dans Git.
# ───────────────────────────────────────────────

# URL publique de Rozana (production, HTTPS obligatoire pour la PWA et le push)
# SITE_URL=https://rozana.exemple.fr   (à activer seulement en production)

# URL publique de PocketBase (utilisée par le navigateur ET le serveur)
PUBLIC_PB_URL=http://127.0.0.1:8090

# URL interne de PocketBase côté serveur (facultatif, si différente)
# PB_INTERNAL_URL=http://pocketbase:8090

# Fuseau horaire par défaut (modifiable ensuite dans les paramètres)
PUBLIC_DEFAULT_TIMEZONE=Europe/Paris

# Création du compte personnel (script `npm run owner:create`, Phase 2).
# Utilisés UNE seule fois en local, puis à retirer du fichier.
# PB_SUPERUSER_EMAIL=
# PB_SUPERUSER_PASSWORD=

# Notifications push (Phase 5) — générer avec `npx web-push generate-vapid-keys`
# PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:toi@exemple.fr

# Assistant IA (Phase 6) — fournisseur interchangeable
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=
# AI_MAX_REQUESTS_PER_DAY=50
