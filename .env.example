# ───────────────────────────────────────────────
# Rozana — variables d'environnement (exemple, sans secrets)
# Copie ce fichier en `.env` et remplis les valeurs localement.
# Ne colle JAMAIS ces valeurs dans une conversation ni dans Git.
# ───────────────────────────────────────────────

# URL publique de Rozana — à activer seulement en production (HTTPS)
# SITE_URL=https://rozana.exemple.fr

# URL publique de PocketBase (navigateur ET serveur). Figée au moment du build.
PUBLIC_PB_URL=http://127.0.0.1:8090

# URL interne de PocketBase côté serveur (facultatif, si différente)
# PB_INTERNAL_URL=http://127.0.0.1:8090

# Fuseau horaire par défaut des nouveaux comptes (modifiable dans les paramètres)
PUBLIC_DEFAULT_TIMEZONE=Europe/Paris

# ── Inscription (lu par PocketBase via `npm run pb`) ──
# open = tout le monde peut créer son espace (par défaut)
# invite = il faut le code ci-dessous · closed = plus d'inscription
# ROZANA_SIGNUP=open
# ROZANA_INVITE_CODE=

# ── Notifications push (voir docs/NOTIFICATIONS.md) ──
# Générer une fois avec : npm run vapid
# PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:toi@exemple.fr

# Compte superuser PocketBase, utilisé UNIQUEMENT par le processus de rappels
# (npm run worker), jamais par le navigateur.
# PB_SUPERUSER_EMAIL=
# PB_SUPERUSER_PASSWORD=

# ── Assistant IA (voir docs/ASSISTANT.md) ──
# AI_PROVIDER=anthropic            # ou "openai" (toute API compatible OpenAI)
# AI_API_KEY=
# AI_MODEL=                        # ex. le modèle de ton fournisseur
# AI_BASE_URL=                     # facultatif (API compatible OpenAI, proxy…)
# AI_MAX_REQUESTS_PER_DAY=50
